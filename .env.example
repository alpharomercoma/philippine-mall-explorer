# Philippine Mall Explorer configuration.
# Every value has a working default, so copying this file is optional. Copy it
# to .env only when you need to change something. Values are read once at
# import; an unparseable value fails immediately and names itself.

# --- paths -------------------------------------------------------------------
# Where snapshots and the HTTP cache live. Point this at a volume if the repo
# is on a small disk.
# MALLSCAPE_DATA_DIR=./data
# Where stage 4 writes the deployable site.
# MALLSCAPE_SITE_DIR=./4_website/site

# --- scraping ----------------------------------------------------------------
# Requests per second, per chain. 3 is deliberate: SM's WAF issues a temporary
# site-wide 403 at sustained higher rates. Lower it, do not raise it.
# MALLSCAPE_REQUEST_RATE=3.0
# MALLSCAPE_REQUEST_TIMEOUT=30.0
# Retries apply to 403, 429 and 5xx with exponential backoff.
# MALLSCAPE_RETRY_ATTEMPTS=8
# MALLSCAPE_RETRY_MAX_WAIT=300.0
# Sent on every request. Keep it identifying rather than disguising.
# MALLSCAPE_USER_AGENT=...
# Browser whose TLS handshake requests present (a curl_cffi impersonate
# target). Cloudflare challenges a plain Python handshake from cloud ranges.
# MALLSCAPE_IMPERSONATE=chrome
# A rotating proxy endpoint (http://user:password@host:port) that gives every
# request a new exit IP. It holds credentials: keep it in .env or a CI secret,
# never in the repo. Unset means every request goes direct, which is all a
# residential connection needs.
# MALLSCAPE_PROXY_URL=
# Chains that go through it (comma separated). Residential proxy traffic is
# billed by the gigabyte, so only the chains that refuse the runner belong here.
# MALLSCAPE_PROXY_CHAINS=sm

# Upper bound on pagination loops. This is a runaway guard, not a limit: it is
# far above any real directory, and hitting it raises rather than truncating.
# MALLSCAPE_MAX_PAGES=500

# A chain that lost more than half its listings since the previous run keeps
# that run's rows instead, because a collapse is usually the operator's site
# breaking rather than the malls emptying; the chain's `fetched` date in the
# report shows the staleness. When the shrink is real, name the chains (comma
# separated, or "all") to keep the new rows for one run.
# MALLSCAPE_ACCEPT_COLLAPSE=

# --- geocoding ---------------------------------------------------------------
# Only `mallscape geocode` reads these. Both services are free and need no key.
# Nominatim's usage policy asks for at most one request per second and a
# User-Agent that identifies the caller, which is what the defaults do. Raising
# the rate breaks that agreement, so leave it alone.
# Overpass endpoints, comma separated, tried in order until one returns data.
# MALLSCAPE_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# MALLSCAPE_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Read the other way round: what is at a coordinate. Only `geocode --verify`
# uses it, to find pins that are not on land or not where the address says.
# MALLSCAPE_NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
# MALLSCAPE_GEOCODE_RATE=1.0
# MALLSCAPE_GEOCODE_OVERPASS_TIMEOUT=180.0
# MALLSCAPE_GEOCODER_USER_AGENT=mallscape-geocoder/1.0 (+<repo url>)

# --- website -----------------------------------------------------------------
# MALLSCAPE_SITE_PORT=3000
# MALLSCAPE_SITE_REPO_URL=https://github.com/alpharomercoma/philippine-mall-explorer
# Map tiles. OpenStreetMap's standard tiles are free and need no key. The build
# rewrites the page's Content-Security-Policy from this value, so pointing it
# at another tile server is all that is required to switch; a template without
# {z}, {x} and {y} fails the build rather than producing a blank map.
# MALLSCAPE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MALLSCAPE_TILE_ATTRIBUTION=© OpenStreetMap contributors
# The page sends no referrer, which is right for privacy and wrong for tiles:
# OpenStreetMap's usage policy needs a Referer or an identifying User-Agent to
# attribute the request, and a browser cannot set the second. This applies to
# the tile images only and sends the origin without the path. Setting it to
# no-referrer will get the tiles refused.
# MALLSCAPE_TILE_REFERRER_POLICY=strict-origin-when-cross-origin
